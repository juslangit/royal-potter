cs=d['customers']
assert len(cs)==6
assert len({c['id'] for c in cs})==6
assert {'king','queen','knight','wizard'} <= {c['id'] for c in cs}
assert [c['tower'] for c in cs]==['round_keep','watchtower','turret','gatehouse','onion_dome','spire']
base={'name','role','look','arrive','wish','react','sploosh','tower','glaze_hint'}
palette=set(re.findall(r'#[0-9A-F]{6}', Path('art/concept/palette.md').read_text()))
glazes={'cream_crown','sage_keep','sky_spire','honey_hall','rose_turret','terracotta_throne'}
for c in cs+[d['dragon']]:
    expected=base|({'id'} if c in cs else {'tower_shape','tower_height'})
    assert set(c)==expected, c['name']
    for field,limit in [('arrive',50),('wish',70),('sploosh',40)]:
        assert isinstance(c[field],str) and 0<len(c[field])<=limit,(c['name'],field,len(c[field]))
    assert len(c['react'])==4
    assert all(isinstance(s,str) and 0<len(s)<=40 for s in c['react']),c['name']
    assert c['glaze_hint'] in glazes
    colours=re.findall(r'#[0-9A-F]{6}',c['look'])
    assert colours and set(colours)<=palette
    print(c['name']+': dialogue lengths, reaction count, palette and fields OK')
dr=d['dragon']
assert dr['tower'] not in {c['tower'] for c in cs}
assert len(dr['tower_shape'])==10 and all(isinstance(w,(float,int)) and .1<=w<=1 for w in dr['tower_shape'])
assert 1.6<=dr['tower_height']<=2.6
assert len(d['ending'])==3 and all(0<len(s)<=60 for s in d['ending'])
assert p.read_text().isascii(), 'Only English ASCII text expected; no emoji'
text=Path('art/writing/itch-page.md').read_text()
description=text.split('## Description\\n\\n')[1].strip()
count=len(description.split())
print('Description words:',count)
assert count==120,count
print('PASS: JSON schema, all brief constraints, and 120-word description')
