/Applications/Blender.app/Contents/MacOS/Blender
/Users/luqman/.local/bin/docs-build
#!/usr/bin/env python3
"""Builds a project record for a project that has no builder of its own.

Luqman's games each carry a hand-tuned `tools/docs/build_docs.py` with curated screenshot
galleries and a written pipeline. Every other project — the add-ons, the web apps, the
agents — has notes in the knowledge base, a git history and some pictures, and that is
already a record worth reading. This builds one from those, in the same shape and the same
type as the game records, so the documentation website reads as one thing.

    docs-build                      build the record for the project in this folder
    docs-build ~/Desktop/project/web/portfolio
    docs-build --all                every project that has no builder of its own
    docs-build --all --publish      ...and then rebuild the local records site

What it reads, all of it optional except the notes:

    ~/.claude/knowledge/projects/<slug>/*.md and log/*.md    the writing
    git log                                                  the history and the dates
    any PNG/JPG in the repo's usual picture folders           the screens
    the header comment of each test or tool file              what proves it works

It writes `docs/index.html` in the project, one self-contained file with every picture
embedded as a JPEG, which `docs-site publish` then gathers into the local records
site at ~/Documents/dev/docs-site/<slug>/index.html. Nothing is deployed: Luqman
asked on 2026-09-17 to stop using Netlify and keep the records on this machine.

The markdown converter, the image embedding and the page template live in
~/Documents/dev/tools/docs-engine/engine.py — lifted from a game's builder so both kinds of
record look identical. A project that outgrows this should get its own copy of a game
builder instead; this one never invents prose, it only arranges what is already written.
"""

import datetime
import html
import pathlib
import re
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path.home() / "Documents/dev/tools/docs-engine"))
import engine                                                    # noqa: E402

PROJECTS = pathlib.Path.home() / "Desktop/project"
KNOWLEDGE = pathlib.Path.home() / ".claude/knowledge/projects"

# The site's own colours — warm paper in the light, the near-black and amber of the index
# page in the dark — in the variable names the engine's template expects.
FONTS = ("https://fonts.googleapis.com/css2?family=Inter+Tight:wght@700;800&"
         "family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@500&display=swap")
LIGHT = """--ground: #FAF7F2; --surface: #FFFFFF; --ink: #2B2622; --muted: #6B6259; --line: #E7E1D8;
  --accent: #2F6BB0; --accent-soft: #D6E6FA; --flag: #FFEEC9; --flag-ink: #A97B12; --done: #2F7A5C;
  --display: "Inter Tight", "Helvetica Neue", Arial, sans-serif;
  --body: "Inter", -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --heading-case: none;"""
DARK = """--ground: #FAF7F2; --surface: #FFFFFF; --ink: #2B2622; --muted: #6B6259; --line: #E7E1D8;
  --accent: #2F6BB0; --accent-soft: #D6E6FA; --done: #2F7A5C;"""

# Where pictures tend to live. First match wins as the cover image.
PICTURE_DIRS = ["docs", "dev/shots", "web/img", "img", "screenshots", "assets/screens",
                "assets/img", "docs/img", "docs/shots", "media"]
PICTURE_TYPES = (".png", ".jpg", ".jpeg")
SKIP_PICTURES = re.compile(r"(icon|favicon|logo|badge|sprite|texture|tile)", re.I)

# Files whose header comment says what they do — the same idea as a game's CATALOGUES.
CATALOGUE_PATTERNS = [
    ("tests", "Tests and checks", "Every test file, described by the comment it opens with.",
     ["test/*.py", "tests/*.py", "test/*.js", "tests/*.js", "tests/*.sh", "test/*.sh",
      "dev/checks/*.gd", "tests/*.gd", "tests/**/*.lua", "tests/*.luau"]),
    ("tools", "Scripts and tools", "The scripts kept beside the project, and what each is for.",
     ["tools/*.py", "tools/*.sh", "scripts/*.py", "scripts/*.sh", "tools/**/*.py"]),
]

NOTES = [
    ("idea", "The idea", "01-idea.md", None),
    ("planning", "Planning", "02-planning.md", None),
    ("milestones", "Milestones", "03-milestones.md", 2),
    ("methods", "Methods", "04-methods.md", 2),
    ("relations", "What it depends on", "05-relations.md", None),
    ("decisions", "Decisions", "06-decisions.md", 2),
    ("references", "References", "07-references.md", None),
]

ACRONYMS = {"lms", "ai", "3d", "2d", "ui", "ux", "vr", "ar", "api", "cli", "mcp", "pdf", "sql"}

SOURCE_TYPES = [".py", ".js", ".ts", ".html", ".css", ".gd", ".lua", ".luau", ".sh", ".gdshader"]


# --- what the project can tell us about itself ------------------------------------------

def project_name(slug, notes):
    """The name from the overview's title, or the folder name made presentable."""
    overview = notes / "00-overview.md"
    if overview.exists():
        found = re.search(r"^#\s+(.+?)\s*(?:—|-)\s*Overview\s*$", overview.read_text(), re.M)
        if found and found.group(1).strip().lower() != slug:
            return found.group(1).strip()
    words = []
    for word in slug.replace("_", "-").split("-"):
        words.append(word.upper() if word.lower() in ACRONYMS else word.capitalize())
    return " ".join(words)


def pictures(project):
    """[(path relative to the project, folder it came from)], newest folders last."""
    found, seen = [], set()
    for folder in PICTURE_DIRS:
        directory = project / folder
        if not directory.is_dir():
            continue
        for path in sorted(directory.iterdir()):
            if (path.suffix.lower() in PICTURE_TYPES and not SKIP_PICTURES.search(path.name)
                    and path.name not in seen and path.stat().st_size > 12000):
                seen.add(path.name)
                found.append((str(path.relative_to(project)), folder))
    return found


def caption(path):
    """A filename read back as words: `hud_badminton.png` → "Hud badminton"."""
    stem = pathlib.Path(path).stem
    stem = re.sub(r"^[_\d\-]+", "", stem)
    return re.sub(r"[-_]+", " ", stem).strip().capitalize() or pathlib.Path(path).stem


def counts(project, notes, source):
    """The few numbers on the cover. Only ones that are true of every kind of project."""
    facts = []
    log = engine.git("log", "--pretty=format:%ad", "--date=short").split("\n")
    log = [line for line in log if line]
    if log:
        facts.append(("commits", f"{len(log):,}"))
        started = datetime.date.fromisoformat(log[-1])
        days = (datetime.date.today() - started).days + 1
        facts.append(("days of work", f"{days:,}"))
    if source:
        lines = sum(len(p.read_text(errors="replace").split("\n")) for p in source)
        facts.append(("source files", f"{len(source):,}"))
        facts.append(("lines of code", f"{lines:,}"))
    decisions = engine.decisions()
    if decisions:
        facts.append(("decisions recorded", str(decisions)))
    sessions = list((notes / "log").glob("*.md")) if (notes / "log").is_dir() else []
    sessions = [p for p in sessions if not p.name.startswith("_")]
    if sessions:
        facts.append(("sessions logged", str(len(sessions))))
    return facts


def source_files(project):
    """The project's own code. Git decides what belongs to it where there is a repo —
    otherwise downloaded reference material and build output get counted as work."""
    ignore = re.compile(r"(^|/)(\.git|node_modules|\.godot|build|dist|addons/[^/]+/lib|"
                        r"venv|__pycache__|assets|\.venv|dev/ref|vendor|third_party)(/|$)")
    tracked = engine.git("ls-files").split("\n")
    names = [n for n in tracked if n] or [
        str(p.relative_to(project)) for p in project.rglob("*") if p.is_file()]
    found = []
    for name in sorted(names):
        path = project / name
        if path.is_file() and path.suffix.lower() in SOURCE_TYPES and not ignore.search(name):
            found.append(path)
    return found


# --- the page ---------------------------------------------------------------------------

def build(project, publish=False):
    slug = project.name
    notes = KNOWLEDGE / slug
    if not notes.is_dir():
        print(f"  {slug}: no notes at {notes} — skipped")
        return None
    name = project_name(slug, notes)
    engine.configure(project, notes, slug, name)

    taken = set()
    overview_path = notes / "00-overview.md"
    overview = re.sub(r"\A---\n.*?\n---\n", "", overview_path.read_text(), flags=re.S) \
        if overview_path.exists() else ""
    thesis = re.search(r"^# .*?\n\n(.+?)(?=\n\n)", overview, re.S | re.M)
    thesis = " ".join(l.lstrip("> ").strip() for l in thesis.group(1).split("\n")) if thesis else ""
    built = datetime.date.today().isoformat()
    branch = engine.git("branch", "--show-current").strip()
    source = source_files(project)
    shots = pictures(project)

    toc, body = [], []

    # Cover
    stats = "".join(f'<div class="stat"><b>{html.escape(v)}</b><span>{html.escape(k)}</span></div>'
                    for k, v in counts(project, notes, source))
    # A cover picture only when one was clearly meant as one — otherwise every picture
    # goes in the gallery rather than an arbitrary first file standing in for the project.
    hero, hero_path = "", None
    for path, _ in shots:
        stem = pathlib.Path(path).stem.lower()
        if re.match(r"^(hero|cover|main|screenshot|banner)", stem) or slug.replace("-", "") in stem.replace("-", "").replace("_", ""):
            hero_path = path
            break
    if hero_path:
        uri, _, width, height = engine.picture(hero_path)
        if uri:
            hero = (f'<img class="hero" src="{uri}" alt="{html.escape(caption(hero_path))}" '
                    f'width="{width}" height="{height}">')
    body.append(f'''
<header class="cover" id="top">
  <p class="eyebrow"><b>{html.escape(name)}</b><span>Project record · built {built}{f" from {html.escape(branch)}" if branch else ""}</span></p>
  <h1>{html.escape(name)}</h1>
  <p class="thesis">{engine.inline(html.escape(thesis, quote=False))}</p>
  <div class="stats">{stats}</div>
  {hero}
</header>''')

    # Overview
    rest = re.sub(r"^# .*?\n\n.+?\n\n", "", overview, count=1, flags=re.S | re.M)
    toc.append(("overview", "Overview", []))
    body.append(f'''
<section class="chapter notes" id="overview">
  <p class="kicker">00-overview.md</p>
  <h2>Overview</h2>
  <div class="prose">{engine.markdown(rest, "overview", taken, None)}</div>
</section>''')

    # Screens — grouped by the folder the pictures were found in
    if shots:
        groups, subs, parts = {}, [], []
        for path, folder in [(p, f) for p, f in shots if p != hero_path]:
            groups.setdefault(folder, []).append(path)
        for folder, paths in groups.items():
            gid = engine.slug(f"shots-{folder}", taken)
            subs.append((gid, folder))
            figures = [engine.figure(p, caption(p)) for p in paths]
            parts.append(f'<section class="gallery" id="{gid}"><h3>{html.escape(folder)}/</h3>'
                         f'<p class="note">Every picture kept in <code>{html.escape(folder)}</code>, '
                         f'with the date the file itself carries.</p>'
                         f'{engine.grid(figures, "wide" if len(figures) > 2 else "")}</section>')
        if parts:
            toc.append(("screens", "Screens", subs))
            body.append(f'''
<section class="chapter" id="screens">
  <p class="kicker">What it looks like</p>
  <h2>Screens</h2>
  <p class="lede">The pictures kept in the repo. Each carries the date it was made, so an old one says it is old rather than being quietly replaced.</p>
  {"".join(parts)}
</section>''')

    # The notes, one chapter each
    for nid, title, filename, fold in NOTES:
        path = notes / filename
        if not path.exists():
            continue
        text = path.read_text()
        if len(text.strip()) < 40:
            continue
        converted = engine.markdown(text, nid, taken, fold)
        heads = re.findall(r"^## (.+)$", re.sub(r"```.*?```", "", text, flags=re.S), re.M)
        folds = f' <button class="unfold" type="button" data-for="{nid}">Open all</button>' if fold else ""
        toc.append((nid, title, []))
        body.append(f'''
<section class="chapter notes" id="{nid}">
  <p class="kicker">{html.escape(filename)} · {len(heads)} sections{folds}</p>
  <h2>{html.escape(title)}</h2>
  <div class="prose">{converted}</div>
</section>''')

    # Session log
    log_dir = notes / "log"
    logs = sorted((p for p in log_dir.glob("*.md") if not p.name.startswith("_")), reverse=True) \
        if log_dir.is_dir() else []
    if logs:
        entries = "".join(
            f'<details class="fold" id="log-{p.stem}"><summary><span>{p.stem}</span></summary>'
            f'<div>{engine.markdown(p.read_text(), "log-" + p.stem, taken, None)}</div></details>'
            for p in logs)
        toc.append(("log", "Session log", []))
        body.append(f'''
<section class="chapter notes" id="log">
  <p class="kicker">log/ · {len(logs)} session{"" if len(logs) == 1 else "s"} <button class="unfold" type="button" data-for="log">Open all</button></p>
  <h2>Session log</h2>
  <div class="prose">{entries}</div>
</section>''')

    # Tests and tools, each described by its own header comment
    folds = []
    for cid, title, intro, patterns in CATALOGUE_PATTERNS:
        if any(engine.files(pattern) for pattern in patterns):
            folds.append(f'<details class="fold" id="{cid}"><summary><span>{html.escape(title)}</span></summary>'
                         f'<div><p class="note">{html.escape(intro)}</p>{engine.catalogue(patterns)}</div></details>')
    if folds:
        toc.append(("checks", "Tests and tools", []))
        body.append(f'''
<section class="chapter" id="checks">
  <p class="kicker">What proves it works, from each file's own header comment</p>
  <h2>Tests and tools</h2>
  {"".join(folds)}
</section>''')

    # Git history
    if branch or engine.git("log", "-1"):
        toc.append(("history", "Git history", []))
        body.append(f'''
<section class="chapter" id="history">
  <p class="kicker">git log{f" on {html.escape(branch)}" if branch else ""}, newest first</p>
  <h2>Git history</h2>
  <details class="fold"><summary><span>Every commit</span></summary><div>{engine.history()}</div></details>
</section>''')

    nav = []
    for tid, title, subs in toc:
        inner = "".join(f'<li><a href="#{sid}">{html.escape(st)}</a></li>' for sid, st in subs)
        nav.append(f'<li><a href="#{tid}">{html.escape(title)}</a>{f"<ul>{inner}</ul>" if inner else ""}</li>')

    document = (engine.TEMPLATE.replace("{{TITLE}}", html.escape(f"{name} Record"))
                .replace("{{FONTS}}", FONTS).replace("{{LIGHT}}", LIGHT).replace("{{DARK}}", DARK)
                .replace("{{NAV}}", "".join(nav)).replace("{{BODY}}", "".join(body)))

    out = project / "docs" / "index.html"
    out.parent.mkdir(exist_ok=True)
    out.write_text(document)
    size = out.stat().st_size / 1024 / 1024
    print(f"  {slug}: {size:.1f} MB, {len(toc)} chapters, {len(shots)} pictures, {len(source)} source files")
    return out


def buildable():
    """Projects with notes and no builder of their own.

    Looked for at two depths: a project may live inside another one now —
    bengkel holds boneka and gerak — and the notes folder is what decides
    whether a directory is a project at all, so a hub's `native` and `web`
    folders are passed over without needing a rule of their own.
    """
    seen = set()
    for pattern in ("*/*", "*/*/*"):
        for path in sorted(PROJECTS.glob(pattern)):
            if path in seen or not path.is_dir():
                continue
            if (path / "tools/docs/build_docs.py").exists():
                continue
            if not (KNOWLEDGE / path.name).is_dir():
                continue
            seen.add(path)
            yield path


def main():
    argv = sys.argv[1:]
    publish = "--publish" in argv
    argv = [a for a in argv if not a.startswith("--")]

    if "--all" in sys.argv:
        targets = list(buildable())
        print(f"building {len(targets)} records")
    elif argv:
        targets = [pathlib.Path(argv[0]).expanduser().resolve()]
    else:
        targets = [pathlib.Path.cwd()]

    for project in targets:
        build(project)
    if publish:
        subprocess.run(["docs-site", "publish"], check=True)


if __name__ == "__main__":
    main()

